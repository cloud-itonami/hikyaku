;; hikyaku (飛脚) — 法律がまだ紙に留めている手続きの「使者」層: 収入印紙の購入・貼付・封入・
;; 追跡郵便での発送・受領証の保全を、1 step ごとに証拠を要求する human-computing として回す。
;; 判断は shomen（kotoba-lang）に依存する。テストの第一経路は nbb:
;;   kbb --backend sci --classpath src:test:../../kotoba-lang/shomen/src run_tests.cljk
{:paths ["src"]
 :deps {
        ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test {:git/url "https://github.com/kotoba-lang/test.git"
                                    :git/sha "2ab4885f99fd25552d380d0f6b0b54c5a72eb7ae"}io.github.kotoba-lang/shomen
        {:local/root "../../kotoba-lang/kotoba/lib/kotoba.shomen"}}
 :aliases {:test {:extra-paths ["test"]}}}
